# Central de Partituras: o repositório leva só o aplicativo e a documentação.
# Fotos, músicas, partituras geradas, o estado do programa e o que o
# instalar.sh baixa ficam só no computador.

# Raiz: tudo fica de fora, menos o que está liberado com "!".
# (Ficam de fora, por exemplo: entrada/, musicas/, partituras/, exportados/,
#  .estado/ e o MANUAL.pdf, que é gerado a partir do MANUAL.md.)
/*
!/.gitignore
!/README.md
!/MANUAL.md
!/abrir-conversor.sh
!/conversor/

# Baixado ou criado pelo conversor/instalar.sh
/conversor/.venv/
/conversor/audiveris/
/conversor/tessdata/

# Leituras reais de uma partitura protegida por direitos autorais, usadas
# como referência nos testes. Sem elas, esses testes são pulados.
/conversor/testes/dados/

# Gerados pelo Python
__pycache__/
*.py[cod]

# Editores e sistema
*~
*.swp
.vscode/
.idea/
.DS_Store
